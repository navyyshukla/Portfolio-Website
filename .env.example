# AI assistant (/api/chat). Everything here is free-tier, no credit card.
# With no provider key set, /api/chat returns 503 and the UI tells visitors to
# email instead — the site itself works fine without any of this.

# Primary provider. console.groq.com — chosen because it does not retain or
# train on inference data by default. Free: 30 RPM, 14,400 req/day.
GROQ_API_KEY=
# Optional override. Free-tier catalogues change without notice.
# TPM, not requests/day, is the binding limit: the corpus is resent every call.
# Measured from Groq's rate-limit headers — 70B has 12,000 TPM vs the 8B's 6,000.
GROQ_MODEL=llama-3.3-70b-versatile
# Overflow for when the 70B's 1,000/day runs out (the 8B allows 14,400/day).
GROQ_MODEL_FALLBACK=llama-3.1-8b-instant

# Fallback, used only on 429/5xx. aistudio.google.com
# NOTE: Google's free tier is marked "used to improve our products" — visitor
# questions sent here become training data. That is why it is the fallback.
GEMINI_API_KEY=
# `gemini-2.5-flash` started returning 404 "no longer available to new users".
# `-latest` tracks the current model so it cannot go stale the same way.
GEMINI_MODEL=gemini-flash-latest

# Rate limiting. console.upstash.com, free tier, no card.
# Without these the route falls back to a per-instance in-memory limiter, which
# is a partial backstop only (Vercel scales out; each instance starts at zero).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
